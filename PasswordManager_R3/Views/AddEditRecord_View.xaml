                                            M 8.5136719 14.517578 L 7.7753906 15.193359 C 8.8250856 16.344043 10.372323 16.997377 12 17 C 13.62768 16.9974 15.174915 16.344043 16.224609 15.193359 L 15.486328 14.517578 C 14.640546 15.444731 13.359447 15.997816 12 16 C 10.64055 15.997809 9.3594528 15.44473 8.5136719 14.517578 z" />-->
                                    <Path Fill="{DynamicResource linearGradient88}"
                                          Data="m 22,11.999998 a 10,10 0 0 1 -10,10 10,10 0 0 1 -10,-10 10,10 0 0 1 10,-9.9999999 10,10 0 0 1 10,9.9999999 z" />
                                    <Path Fill="{DynamicResource linearGradient90}"
                                          Data="m 9.5,7.4999995 c 0.554,0 1,0.446 1,1 v 1.9999995 c 0,0.554 -0.446,1 -1,1 -0.554,0 -1,-0.446 -1,-1 V 8.4999995 c 0,-0.554 0.446,-1 1,-1 z" />
                                    <Path Fill="{DynamicResource linearGradient90}"
                                          Data="m 14.5,7.4999995 c 0.554,0 1,0.446 1,1 v 1.9999995 c 0,0.554 -0.446,1 -1,1 -0.554,0 -1,-0.446 -1,-1 V 8.4999995 c 0,-0.554 0.446,-1 1,-1 z" />
                                    <Path Fill="{DynamicResource linearGradient90}"
                                          Data="m 7,13 a 0.5,0.5 0 0 0 -0.3535156,0.146484 l -1,1 a 0.5,0.5 0 0 0 0,0.707032 0.5,0.5 0 0 0 0.7070312,0 L 6.484375,14.722656 C 7.9512362,16.693974 9.9224842,17.5 12,17.5 c 2.077516,0 4.048764,-0.806025 5.515625,-2.777344 l 0.130859,0.13086 a 0.5,0.5 0 0 0 0.707032,0 0.5,0.5 0 0 0 0,-0.707032 l -1,-1 a 0.5,0.5 0 0 0 -0.707032,0 0.5,0.5 0 0 0 0,0.707032 l 0.328125,0.328125 C 15.878457,15.42319 14.118567,16.5 12,16.5 9.8814334,16.5 8.1215433,15.42319 7.0253906,14.181641 l 0.328125,-0.328125 a 0.5,0.5 0 0 0 0,-0.707032 A 0.5,0.5 0 0 0 7,13 Z" />
                                </Grid>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Icon"/>
                        </StackPanel>
                    </ListViewItem.Content>
                </ListViewItem>
                <ListViewItem>
                    <ListViewItem.Content>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24"
                                     Height="24"
                                     Margin="0 0 12 0">
                                <Path Width="24"
                                      Height="24"
                                      Fill="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                      Data="M 6 2 C 4.9006497 2 4 2.9006497 4 4 L 4 20 C 4 21.09935 4.9006497 22 6 22 L 10 22 L 10 21 L 6 21 C 5.4373519 21 5 20.562648 5 20 L 5 4 C 5 3.4373519 5.4373519 3 6 3 L 13 3 L 13 9 L 19 9 L 19 11 L 20 10 L 20 8 L 14 2 L 6 2 z
                                            M 14 3.4140625 L 18.585938 8 L 14 8 L 14 3.4140625 z
                                            M 20.25 12.912109 C 20.051666 12.912109 19.837559 12.955409 19.646484 13.146484 L 18.542969 14.25 L 20.75 16.457031 L 21.853516 15.353516 C 22.04459 15.162441 22.087891 14.948334 22.087891 14.75 C 22.087891 14.551666 22.044591 14.337559 21.853516 14.146484 L 20.853516 13.146484 C 20.662442 12.95541 20.448334 12.91211 20.25 12.912109 z
                                            M 20.25 13.957031 L 21.042969 14.75 L 20.75 15.042969 L 19.957031 14.25 L 20.25 13.957031 z
                                            M 18 14.792969 L 17.646484 15.146484 L 12 20.792969 L 12 23 L 14.207031 23 L 20.207031 17 L 18 14.792969 z
                                            M 18 16.207031 L 18.792969 17 L 13.792969 22 L 13 22 L 13 21.207031 L 18 16.207031 z" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Properties"/>
                        </StackPanel>
                    </ListViewItem.Content>
                </ListViewItem>
            </ListView>
        </Border>

        <!--//  Middle Panel  //-->
        <Border Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <TabControl BorderThickness="0"
                            SelectedIndex="{Binding SelectedIndex,
                                                    ElementName=listViewTabSelector}">
                    <!--//  "Entry" Form  //-->
                    <TabItem Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <!--//  Title  //-->
                            <TextBlock Grid.Column="1"
                                       Grid.Row="0"
                                       Margin="0 0 0 12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="Title"/>
                            <TextBox Grid.Column="2"
                                     Grid.Row="0"
                                     Margin="0 0 0 12"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch">
                                <Binding Path="SrTitle"
                                         Mode="TwoWay">
                                    <Binding.ValidationRules>
                                        <valid:StringValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox>

                            <!--//  Username  //-->
                            <TextBlock Grid.Column="1"
                                       Grid.Row="1"
                                       Margin="0 0 0 12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="Username"/>
                            <TextBox Grid.Column="2"
                                     Grid.Row="1"
                                     Margin="0 0 0 12"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding SrUsername,
                                                    Mode=TwoWay}"/>

                            <!--//  Email  //-->
                            <TextBlock Grid.Column="1"
                                       Grid.Row="2"
                                       Margin="0 0 0 12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="Email"/>
                            <TextBox Grid.Column="2"
                                     Grid.Row="2"
                                     Margin="0 0 0 12"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding SrEmail,
                                                    Mode=TwoWay}"/>

                            <!--//  Password  //-->
                            <TextBlock Grid.Column="1"
                                       Grid.Row="3"
                                       Margin="0 0 0 12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="Password"/>
                            <Grid Grid.Column="2"
                                  Grid.Row="3"
                                  Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="textBoxPassword"
                                         Grid.Column="0"
                                         Margin="0 0 6 0"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         Visibility="Collapsed"
                                         Text="{Binding SrPassword,
                                                        Mode=TwoWay}"
                                         TextChanged="textBoxPassword_TextChanged" />
                                <PasswordBox x:Name="pWrdBox"
                                             Grid.Column="0"
                                             Margin="0 0 6 0"
                                             VerticalContentAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Visibility="Visible"
                                             PasswordChanged="pWrdBox_PasswordChanged" />
                                <ToggleButton x:Name="toggleButtonGeneratePassword"
                                              Grid.Column="1"
                                              Margin="6 0">
                                    <ToggleButton.Content>
                                        <Grid Width="24"
                                              Height="24">
