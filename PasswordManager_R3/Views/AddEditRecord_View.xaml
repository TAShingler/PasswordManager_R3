                                    <Path Fill="{DynamicResource linearGradient57}"
                                          Data="m 8,20 -4,-4 -1.375,4.125 1.25,1.25 z" />
                                    <Path Fill="{DynamicResource linearGradient55}"
                                          Data="m 18.5,9.5 -4,-4 L 4,16 8,20 Z" />
                                    <Path Fill="{DynamicResource linearGradient66}"
                                          Data="m 20,8 -4,-4 -1.5,1.5 4,4 z" />
                                    <Path Fill="{DynamicResource linearGradient53}"
                                          Data="m 18.5,2.1464844 c -0.382149,0 -0.764297,0.1178132 -1,0.3535156 L 16,4 20,8 21.5,6.5 c 0.471404,-0.4714043 0.471404,-1.5285958 0,-2 l -2,-2 C 19.264298,2.2642976 18.882149,2.1464844 18.5,2.1464844 Z" />
                                </Grid>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Entry"/>
                        </StackPanel>
                    </ListViewItem.Content>
                </ListViewItem>
                <ListViewItem>
                    <ListViewItem.Content>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24"
                                     Height="24"
                                     Margin="0 0 12 0">
                                <Grid>
                                    <!--<Path Width="24"
                                      Height="24"
                                      Fill="{Binding Foreground,
                                                     RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                      Data="M 12 2 C 6.4830803 2 2 6.4830803 2 12 C 2 17.51692 6.4830803 22 12 22 C 17.51692 22 22 17.51692 22 12 C 22 6.4830803 17.51692 2 12 2 z
