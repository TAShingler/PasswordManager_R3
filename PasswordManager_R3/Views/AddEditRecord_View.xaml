                                          Height="24"
                                          Fill="{Binding Foreground,
                                                         RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                          Data="M 17.671875 2.9980469 C 17.414375 2.9980469 17.155938 3.0940625 16.960938 3.2890625 L 15.119141 5.1191406 L 18.869141 8.8691406 L 20.710938 7.0390625 C 21.100938 6.6490625 21.100938 6.0008594 20.710938 5.6308594 L 18.369141 3.2890625 C 18.184141 3.0940625 17.929375 2.9980469 17.671875 2.9980469 z
