                            <!--//  URL  //-->
                            <TextBlock Grid.Column="1"
                                       Grid.Row="4"
                                       Margin="0 0 0 12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="URL"/>
                            <TextBox Grid.Column="2"
                                     Grid.Row="4"
                                     Margin="0 0 0 12"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding SrUrl,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                            <!--//  Expiration Date  //-->
                            <CheckBox x:Name="checkBoxExpirationDate"
                                      Grid.Column="0"
                                      Grid.Row="5"
                                      Margin="0 0 0 12"
                                      IsChecked="{Binding SrHasExpirationDate,
                                                          Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1"
                                       Grid.Row="5"
                                       Margin="0 0 0 12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="Expiration date"/>
                            <Grid Grid.Column="2"
                                  Grid.Row="5"
                                  Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="textBoxExpirartionDate"
                                             Grid.Column="0"
                                             Margin="0 0 6 0"
                                             IsEnabled="{Binding IsChecked,
                                                                 ElementName=checkBoxExpirationDate}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Text="{Binding SrExpirationDate,
                                                            Mode=TwoWay}" />
                                    <ToggleButton x:Name="toggleButtonExpirationDate"
                                                  Grid.Column="1"
                                                  Margin="6 0"
                                                  IsEnabled="{Binding IsChecked,
                                                                      ElementName=checkBoxExpirationDate}"
                                                  IsChecked="{Binding IsCalendarDisplayed,
                                                                      Mode=TwoWay}">
                                        <ToggleButton.Content>
                                            <Grid Width="24"
                                                  Height="24">
                                                <Path Width="8"
                                                      Height="8"
                                                      Data="M 0 2 L 4 6 L 8 2 Z"
                                                      Fill="{Binding Foreground,
                                                                     RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
                                            </Grid>
                                        </ToggleButton.Content>
                                    </ToggleButton>
                                </Grid>
                                <ComboBox x:Name="comboBoxExpirationDatePresets"
                                          Grid.Column="1"
                                          Visibility="Collapsed"
                                          Margin="6 0 0 0"
                                          SelectionChanged="comboBoxExpirationDatePresets_SelectionChanged">
                                    <ComboBox.Template>
                                        <ControlTemplate TargetType="{x:Type ComboBox}">
                                            <Grid>
                                                <ToggleButton x:Name="ToggleButton"
                                                              Focusable="false"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsDropDownOpen,
                                                                                  Mode=TwoWay,
                                                                                  RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate x:Name="ComboBoxToggleButton"
                                                                         TargetType="{x:Type ToggleButton}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="24" />
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <Border x:Name="Border"
                                                                        Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                                        CornerRadius="4" />
                                                                <Canvas Height="8"
                                                                        Width="8"
                                                                        Grid.Column="1"
                                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                                                    <Path x:Name="Arrow"
                                                                          Data="M 0 2 L 4 6 L 8 2 Z"
                                                                          Fill="{Binding Foreground,
                                                                                         RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
                                                                </Canvas>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="ContentSite"
                                                                  IsHitTestVisible="False"
                                                                  Content="Presets"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                  Margin="4 0 23 0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left">
                                                </ContentPresenter>
                                                <TextBox x:Name="PART_EditableTextBox"
                                                         Style="{x:Null}"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Bottom"
                                                         Margin="3,3,23,3"
                                                         Focusable="True"
                                                         Background="Transparent"
                                                         Visibility="Hidden">
                                                    <TextBox.Template>
                                                        <ControlTemplate x:Name="ComboBoxTextBox"
                                                                         TargetType="{x:Type TextBox}">
                                                            <Border x:Name="PART_ContentHost"
                                                                    Focusable="False"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="0" />
                                                        </ControlTemplate>
                                                    </TextBox.Template>
                                                </TextBox>
                                                <Popup x:Name="Popup"
                                                       Placement="Bottom"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Slide">
                                                    <Grid x:Name="DropDown"
                                                          SnapsToDevicePixels="True"
                                                          MinWidth="{TemplateBinding ActualWidth}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                        <Border x:Name="DropDownBorder"
                                                                BorderThickness="0"
                                                                BorderBrush="#666"
                                                                Background="#505050"
                                                                CornerRadius="2"/>
                                                        <ScrollViewer Margin="4,6,4,6"
                                                                      SnapsToDevicePixels="True">
                                                            <StackPanel x:Name="PopupItemsHost"
                                                                        IsItemsHost="True"
                                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </ComboBox.Template>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                CommandParameter="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <ComboBoxItem Content="12 Hours" />
                                    <ComboBoxItem Content="24 Hours" />
                                    <Separator />
                                    <ComboBoxItem Content="1 Week" />
                                    <ComboBoxItem Content="2 Weeks" />
                                    <ComboBoxItem Content="3 Weeks" />
                                    <Separator />
                                    <ComboBoxItem Content="1 Month" />
                                    <ComboBoxItem Content="3 Months" />
                                    <ComboBoxItem Content="6 Months" />
                                    <Separator />
                                    <ComboBoxItem Content="1 Year" />
                                    <ComboBoxItem Content="2 Years" />
                                    <ComboBoxItem Content="3 Years" />
                                </ComboBox>


                                <DatePicker Grid.Column="0" />
                                <Menu Grid.Column="1">
                                    <MenuItem Header="Presets"
                                              Icon="{DynamicResource down_arrow}">
                                        <MenuItem Header="12 Hours">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="0"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <MenuItem Header="24 Hours">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="1"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="1 Week">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="2"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <MenuItem Header="2 Weeks">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="3"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <MenuItem Header="3 Weeks">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="4"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="1 Month">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="5"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <MenuItem Header="3 Months">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="6"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <MenuItem Header="6 Months">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="7"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="1 Year">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="8"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <MenuItem Header="2 Years">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="9"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                        <MenuItem Header="3 Years">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Click">
                                                    <i:InvokeCommandAction Command="{Binding ComboBoxExpirationDatePresetsSelectionChangedCommand}"
                                                                           CommandParameter="10"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </MenuItem>
                                    </MenuItem>
                                </Menu>
                            </Grid>

                            <!--//  Notes  //-->
                            <CheckBox x:Name="checkBoxNotes"
                                      Grid.Column="0"
                                      Grid.Row="6"
                                      IsChecked="{Binding SrHasNotes,
                                                          Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1"
                                       Grid.Row="6"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="Notes"/>
                            <TextBox Grid.Column="2"
                                     Grid.Row="6"
                                     Grid.RowSpan="2"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     IsEnabled="{Binding IsChecked,
                                                         ElementName=checkBoxNotes}"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Text="{Binding SrNotes,
                                                    Mode=TwoWay}"/>
                        </Grid>
                    </TabItem>

                    <!--//  "Icon" Form  //-->
                    <TabItem Visibility="Collapsed">
                        <ListBox x:Name="addEditIconSelector"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single"
                                 SelectedIndex="{Binding SrIconIndex,
                                                         Mode=TwoWay}"
                                 ItemsSource="{StaticResource RecordIconsArray}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"
                                               IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <Image Source="{Binding}"
                                               Width="36"
                                               Height="36"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding IconSelectorSelectionChangedCommand}"
                                        CommandParameter="{Binding SelectedIndex}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                    </TabItem>

                    <!--//  "Properties" Form  //-->
                    <TabItem Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <!--//  Created Date  //-->
                            <TextBlock Grid.Column="1"
                                Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="Created"/>
                            <TextBox Grid.Column="2"
                                Grid.Row="0"
                                IsReadOnly="True"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="{Binding SrCreatedDate, Mode=OneTime}"/>

                            <!--//  Modified Date  //-->
                            <TextBlock Grid.Column="1"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="Last Modified"/>
                            <TextBox Grid.Column="2"
                                Grid.Row="1"
                                IsReadOnly="True"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="{Binding SrModifiedDate, Mode=OneTime}"/>

                            <!--//  GUID  //-->
                            <!--//  **MIGHT REMOVE**  //-->
                            <TextBlock Grid.Column="1"
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="GUID"/>
                            <TextBox Grid.Column="2"
                                Grid.Row="2"
                                IsReadOnly="True"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Text="{Binding SrGuid, Mode=OneTime}"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
    </DockPanel>
</UserControl>