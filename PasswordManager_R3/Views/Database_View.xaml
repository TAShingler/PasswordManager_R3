                                               Grid.Row="0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedRecord.ExpirationDate}"/>

                                    <!--//  Row 2  //-->
                                    <TextBlock Grid.Column="2"
                                           Grid.Row="1"
                                           Margin="4 0 0 0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Text="Created Date:" />
