<UserControl x:Name="DatabaseViewUserControl"
             x:Class="PasswordManager_R3.Views.Database_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:PasswordManager_R3.Views"
             xmlns:proj="clr-namespace:PasswordManager_R3"
             xmlns:m="clr-namespace:PasswordManager_R3.Models"
             xmlns:c="clr-namespace:PasswordManager_R3.Converters"
             xmlns:a="clr-namespace:PasswordManager_R3"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             SnapsToDevicePixels="True"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <!--#region//  Converters  //-->
        <c:BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
        <c:BooleanToPathConverter x:Key="BooleanToPathConverter" />
        <c:MutliplyDoubleConverter x:Key="MultiplyDoubleConverter" />
        <c:ActualSizeToMinSizeConverter x:Key="ActualSizeToMinSizeConverter" />
        <c:CheckedToGeometryConverter x:Key="CheckedToGeometryConverter" />
        <c:SelectedRecordPropertyMaskedConverter x:Key="SelectedRecordPropertyMaskedConverter" />
        <c:IntToDrawingImageConverter x:Key="IntToDrawingImageConverter" />
        <c:SelectedIndexToGridLengthConverter x:Key="SelectedIndexToGridLengthConverter" />
        <c:BooleanToMaskedStringConverter x:Key="BooleanToMaskedStringConverter" />
        <!--#endregion//  Converters  //-->

        <!--<Style TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" 
                    Value="{Binding IsExpanded,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="IsSelected"
                    Value="{Binding IsSelected,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
        </Style>-->

        <ContextMenu x:Key="TreeViewItemContextMenu"
                     HorizontalOffset="4"
                     Loaded="TreeViewItemContextMenu_Loaded">
            <MenuItem Header="Add Group"
                      Click="CtMenuItemAddGroup_Click">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                PropertyName="Visibility"
                                                Value="Collapsed" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
            <MenuItem Header="Edit Group"
                      Click="CtMenuItemEditGroup_Click">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                PropertyName="Visibility"
                                                Value="Collapsed" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
            <MenuItem Header="Delete Group"
                      Click="CtMenuItemDeleteGroup_Click">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                PropertyName="Visibility"
                                                Value="Collapsed" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="250"
                              Width="0.01*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition MinWidth="250"
                              Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="200"
                           Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="225"
                           Height="0.01*" />
        </Grid.RowDefinitions>

        <TreeView Name="treeViewGroups"
                  Grid.Row="0"
                  Grid.RowSpan="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="1"
                  ItemsSource="{Binding Groups,
                                        NotifyOnSourceUpdated=True,
                                        NotifyOnTargetUpdated=True,
                                        UpdateSourceTrigger=PropertyChanged}"
                  Visibility="{Binding IsTreeViewVisible,
                                       Converter={StaticResource bool2VisibilityConverter}}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type m:Group}"
                                          ItemsSource="{Binding ChildrenGroups,
                                                                Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"
                                   Margin="4 0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <GridSplitter Grid.Row="0"
                      Grid.RowSpan="3"
                      Grid.Column="1"
                      Grid.ColumnSpan="1"
                      Width="12"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />
        <DataGrid Grid.Row="0"
                  Grid.RowSpan="{Binding TopPanelRowSpan}"
                  Grid.Column="{Binding RightPanelColumn}"
                  Grid.ColumnSpan="{Binding RightPanelColumnSpan}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  RowHeight="{Binding RelativeSource={RelativeSource Self},
                                      Path=FontSize,
                                      Converter={StaticResource MultiplyDoubleConverter},
                                      ConverterParameter=2}"
                  ItemsSource="{Binding ElementName=treeViewGroups,
                                        Path=SelectedItem.ChildrenRecords}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding OnRecordSelectionChangedCommand}"
                                                             CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, 
                                                                                        Path=SelectedItem}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.Columns>
                <DataGridTemplateColumn IsReadOnly="True"
                                        CanUserReorder="False"
                                        CanUserResize="False"
                                        CanUserSort="False"
                                        Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}},
                                                        Path=RowHeight}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type m:Record}">
                            <Image Width="24"
                                   Height="24"
                                   Source="{Binding Path=Icon,
                                                    Converter={StaticResource IntToDrawingImageConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Title"
                                                MinWidth="115"
                                                Width="Auto"
                                                Binding="{Binding Title}" />
                <DataGridTextColumn Header="Username"
                                                MinWidth="115"
                                                Width="Auto">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                            <Binding Path="Username" />
                            <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                 AncestorType={x:Type UserControl}}"
                                                 Path="DataContext.ParentVM.AreDatabaseUsernamesMasked" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Email"
                                                MinWidth="115"
                                                Width="Auto">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                            <Binding Path="Email" />
                            <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                 AncestorType={x:Type UserControl}}"
                                                 Path="DataContext.ParentVM.AreDatabaseEmailsMasked" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Password"
                                                MinWidth="115"
                                                Width="Auto">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                            <Binding Path="Password" />
                            <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                 AncestorType={x:Type UserControl}}"
                                                 Path="DataContext.ParentVM.AreDatabasePasswordsMasked" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Url"
                                                MinWidth="115"
                                                Width="Auto">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                            <Binding Path="URL" />
                            <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                                 AncestorType={x:Type UserControl}}"
                                                 Path="DataContext.ParentVM.AreDatabaseUrlsMasked" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="1"
                      Grid.RowSpan="1"
                      Grid.Column="2"
                      Grid.ColumnSpan="1"
                      Height="12"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />
        <Border Grid.Row="2"
                Grid.RowSpan="1"
                Grid.Column="{Binding RightPanelColumn}"
                Grid.ColumnSpan="{Binding RightPanelColumnSpan}"
                Padding="8"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                Visibility="{Binding IsSelectedRecordInfoPaneVisible,
                                     Converter={StaticResource bool2VisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!--//  Icon and Path  //-->
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Height="32"
                            Margin="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Viewbox Margin="0 0 12 0">
                        <Image Source="{Binding SelectedRecord.Icon,
                                                Converter={StaticResource IntToDrawingImageConverter}}" />
                    </Viewbox>
                    <TextBlock FontSize="24"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedRecord.Title}"
                               FontWeight="Bold" />
                </StackPanel>

                <!--//  Record Details  //-->
