                       Grid.Column="2"
                       MinHeight="24"
                       Height="24"
                       MaxHeight="24"
                       Content="Username:"
                       Margin="0 0 6 0"
                       VerticalContentAlignment="Center" />
                <Label Grid.Row="1"
                       Grid.Column="3"
                       MinHeight="24"
                       Height="24"
                       MaxHeight="24"
                       VerticalContentAlignment="Center"
                       Content="{Binding SelectedRecord.Username}" />

                <Button Grid.Row="2"
                        Grid.Column="0"
                        MinWidth="24"
                        Width="24"
                        MaxWidth="24"
                        MinHeight="24"
                        Height="24"
                        MaxHeight="24"
                        Margin="0 0 6 0"
                        Padding="0"
                        VerticalAlignment="Center"
