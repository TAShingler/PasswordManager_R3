                                            <MultiBinding Converter="{StaticResource SelectedRecordPropertyMaskedConverter}">
                                                <Binding Path="SelectedRecord.URL" />
                                                <Binding ElementName="toggleButtonMaskUrl"
                                                                Path="IsChecked" />
