<UserControl x:Name="DatabaseViewUserControl"
             x:Class="PasswordManager_R3.Views.Database_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:PasswordManager_R3.Views"
             xmlns:proj="clr-namespace:PasswordManager_R3"
             xmlns:m="clr-namespace:PasswordManager_R3.Models"
             xmlns:c="clr-namespace:PasswordManager_R3.Converters"
             xmlns:a="clr-namespace:PasswordManager_R3"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             SnapsToDevicePixels="True" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!--#region//  Converters  //-->
        <c:BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
        <c:BooleanToPathConverter x:Key="BooleanToPathConverter" />
        <c:MutliplyDoubleConverter x:Key="MultiplyDoubleConverter" />
        <c:ActualSizeToMinSizeConverter x:Key="ActualSizeToMinSizeConverter" />
        <c:CheckedToGeometryConverter x:Key="CheckedToGeometryConverter" />
        <c:SelectedRecordPropertyMaskedConverter x:Key="SelectedRecordPropertyMaskedConverter" />
        <c:IntToDrawingImageConverter x:Key="IntToDrawingImageConverter" />
        <c:SelectedIndexToGridLengthConverter x:Key="SelectedIndexToGridLengthConverter" />
        <c:BooleanToMaskedStringConverter x:Key="BooleanToMaskedStringConverter" />
        <!--#endregion//  Converters  //-->

        <Style TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" 
                    Value="{Binding IsExpanded,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="IsSelected"
                    Value="{Binding IsSelected,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
        </Style>

        <ContextMenu x:Key="TreeViewItemContextMenu"
                     HorizontalOffset="4"
                     Loaded="TreeViewItemContextMenu_Loaded">
            <MenuItem Header="Add Group"
                      Click="CtMenuItemAddGroup_Click">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                PropertyName="Visibility"
                                                Value="Collapsed" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
            <MenuItem Header="Edit Group"
                      Click="CtMenuItemEditGroup_Click">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                PropertyName="Visibility"
                                                Value="Collapsed" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
            <MenuItem Header="Delete Group"
                      Click="CtMenuItemDeleteGroup_Click">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                PropertyName="Visibility"
                                                Value="Collapsed" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    
    <Grid x:Name="parentGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="250"
                              Width="0*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition MinWidth="{Binding ActualWidth,
                                                 ElementName=parentGrid,
                                                 Converter={StaticResource ActualSizeToMinSizeConverter},
                                                 ConverterParameter=width}"
                              Width="*" />
        </Grid.ColumnDefinitions>

        <TreeView x:Name="treeViewGroups"
                  IsEnabled="True"
                  ItemsSource="{Binding Groups,
                                        NotifyOnSourceUpdated=True,
                                        NotifyOnTargetUpdated=True,
                                        UpdateSourceTrigger=PropertyChanged}"
                  MouseRightButtonUp="TreeViewItem_MouseRightButtonUp"
                  ContextMenuClosing="treeViewGroups_ContextMenuClosing"
                  ContextMenuOpening="treeViewGroups_ContextMenuOpening"
                  ContextMenu="{StaticResource TreeViewItemContextMenu}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type m:Group}"
                                          ItemsSource="{Binding ChildrenGroups,
                                                                Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"
                                   Margin="4 0" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedItemChanged">
                    <i:InvokeCommandAction Command="{Binding GroupSelectedItemChangedCommand}"
                                           CommandParameter="{Binding SelectedItem,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="Loaded">
                    <i:InvokeCommandAction Command="{Binding TreeViewLoadedCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TreeView>
        <GridSplitter Grid.Column="1"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserResizeRows="False"
                      RowHeaderWidth="0"
                      AutoGenerateColumns="False"
                      HeadersVisibility="All"
                      IsReadOnly="True"
                      VerticalContentAlignment="Center"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ItemsSource="{Binding SelectedItem.ChildrenRecords,
                                            ElementName=treeViewGroups}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding OnRecordSelectionChangedCommand}"
                                   CommandParameter="{Binding SelectedItem,
                                                              RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                
                <DataGrid.Columns>
                    <DataGridTemplateColumn CanUserResize="False"
                                            CanUserReorder="False"
                                            CanUserSort="False"
                                            MinWidth="32"
                                            MaxWidth="32">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type m:Record}">
                                <Image Width="24"
                                       Height="24"
                                       Source="{Binding Path=Icon,
                                                        Converter={StaticResource IntToDrawingImageConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Title"
                                        MinWidth="120"
                                        Width="Auto"
                                        Binding="{Binding Title}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="Padding"
                                        Value="8" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Username"
                                        MinWidth="120"
                                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="Padding"
                                        Value="8" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="Username" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                         AncestorType={x:Type UserControl}}"
                                         Path="DataContext.ParentVM.AreDatabaseUsernamesMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Email"
                                        MinWidth="120"
                                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="Padding"
                                        Value="8" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="Email" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                         AncestorType={x:Type UserControl}}"
                                         Path="DataContext.ParentVM.AreDatabaseEmailsMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Password"
                                        MinWidth="120"
                                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="Padding"
                                        Value="8" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="Password" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                         AncestorType={x:Type UserControl}}"
                                         Path="DataContext.ParentVM.AreDatabasePasswordsMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Url"
                                        MinWidth="120"
                                        Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="Padding"
                                        Value="8" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="URL" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                         AncestorType={x:Type UserControl}}"
                                         Path="DataContext.ParentVM.AreDatabaseUrlsMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <!--<DataGrid x:Name="dataGridRecords"
                      Grid.Row="0"
                      Background="Transparent"
                      BorderBrush="LightBlue"
                      BorderThickness="0"
                      SnapsToDevicePixels="True"
                      VerticalGridLinesBrush="Transparent"
                      HorizontalGridLinesBrush="#666"
                      RowBackground="Transparent"
                      AutoGenerateColumns="False"
                      HeadersVisibility="All"
                      RowHeaderWidth="0"
                      MinRowHeight="24"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      RowHeight="{Binding RelativeSource={RelativeSource Self},
                                          Path=FontSize,
                                          Converter={StaticResource MultiplyDoubleConverter},
                                          ConverterParameter=2}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      ItemsSource="{Binding ElementName=treeViewGroups,
                                            Path=SelectedItem}">
                <DataGrid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=dataGridOpacityMask}" />
                </DataGrid.OpacityMask>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding OnRecordSelectionChangedCommand}"
                                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, 
                                                                              Path=SelectedItem}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <DataGrid.Columns>
                    <DataGridTemplateColumn CanUserResize="False"
                                                CanUserReorder="False"
                                                CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type m:Record}">
                                <Image Width="24"
                                           Height="24" 
                                           Source="{Binding Path=Icon,
                                                            Converter={StaticResource IntToDrawingImageConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Title"
                                            MinWidth="115"
                                            Width="Auto"
                                            Binding="{Binding Title}" />
                    <DataGridTextColumn Header="Username"
                                            MinWidth="115"
                                            Width="Auto">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="Username" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                             AncestorType={x:Type UserControl}}"
                                             Path="DataContext.ParentVM.AreDatabaseUsernamesMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Email"
                                            MinWidth="115"
                                            Width="Auto">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="Email" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                             AncestorType={x:Type UserControl}}"
                                             Path="DataContext.ParentVM.AreDatabaseEmailsMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Password"
                                            MinWidth="115"
                                            Width="Auto">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="Password" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                             AncestorType={x:Type UserControl}}"
                                             Path="DataContext.ParentVM.AreDatabasePasswordsMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Url"
                                            MinWidth="115"
                                            Width="Auto">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource BooleanToMaskedStringConverter}">
                                <Binding Path="URL" />
                                <Binding RelativeSource="{RelativeSource Mode=FindAncestor,
                                                                             AncestorType={x:Type UserControl}}"
                                             Path="DataContext.ParentVM.AreDatabaseUrlsMasked" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>-->
            <!--<GridSplitter Grid.Row="1"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />-->
            <Border Grid.Row="2"
                    Panel.ZIndex="0"
                    Padding="12 6 12 12"
                    Margin="0 12 0 0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="4"
                    Visibility="{Binding IsSelectedRecordInfoPaneVisible,
                                         Converter={StaticResource bool2VisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                
                    <!--// ROW 1 //-->
                    <Viewbox Grid.Column="0"
                             Grid.Row="0"
                             Width="32"
                             Height="32"
                             Margin="8">
                        <Image Source="{Binding SelectedRecord.Icon,
                                                Converter={StaticResource IntToDrawingImageConverter}}" />
                    </Viewbox>

                    <TextBlock Grid.Column="1"
                               Grid.Row="0"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedRecord.Title}" />

                    <Button Grid.Column="2"
                            Grid.Row="0"
                            Command="{Binding ToggleSelectedRecordInfoPaneVisibilityCommand}">
                        <Button.Content>
                            <Path Width="10"
                                  Height="5"
                                  Fill="{Binding Foreground,
                                                 RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Data="M 0 0 H 10 L 5 5 Z" />
                        </Button.Content>
                    </Button>

                    <!--// ROW 2 //-->
                    <TabControl Grid.Column="0"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="0 6 0 0"
                                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                BorderThickness="1">
                        <TabItem Header="Basic"
                                 Margin="0 0 0 -1"
                                 BorderThickness="1 1 1 0">
                            <Border Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <!--//  Row 1  //-->
                                    <Button Grid.Column="0"
                                            Grid.Row="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding CopyToClipboardCommand}"
                                            CommandParameter="{Binding SelectedRecord.Username}">
                                        <Button.Content>
                                            <Path Width="16"
                                                  Height="16"
                                                  Fill="{Binding Foreground,
                                                                 RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  Data="M 8,1 C 6.9013539,1 6,1.9013539 6,3 H 3.5 C 2.6776494,3 2,3.6776494 2,4.5 v 9 C 2,14.322351 2.6776494,15 3.5,15 h 9 c 0.822351,0 1.5,-0.677649 1.5,-1.5 v -9 C 14,3.6776494 13.322351,3 12.5,3 H 10 C 10,1.9013539 9.0986461,1 8,1 Z
                                                        M 8,2 C 8.5522847,2 9,2.4477153 9,3 9,3.5522847 8.5522847,4 8,4 7.4477153,4 7,3.5522847 7,3 7,2.4477153 7.4477153,2 8,2 Z
                                                        M 3.5,4 H 5 v 1 h 6 V 4 h 1.5 C 12.785648,4 13,4.2143517 13,4.5 v 9 c 0,0.285648 -0.214352,0.5 -0.5,0.5 h -9 C 3.2143517,14 3,13.785648 3,13.5 v -9 C 3,4.2143517 3.2143517,4 3.5,4 Z
                                                        M 5,7 v 1 h 6 V 7 Z
                                                        m 0,2 v 1 h 6 V 9 Z
                                                        m 0,2 v 1 h 4 v -1 z" />
                                        </Button.Content>
                                    </Button>
                                    <ToggleButton x:Name="toggleButtonMaskUsername"
                                                  Grid.Column="1"
                                                  Grid.Row="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Command="{Binding ToggleUsernameMaskCommand}"
                                                  CommandParameter="{Binding IsChecked,
                                                                             RelativeSource={RelativeSource Mode=Self}}">
                                        <ToggleButton.Content>
                                            <MultiBinding Converter="{StaticResource BooleanToPathConverter}">
                                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="Foreground" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </ToggleButton.Content>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="2"
                                           Grid.Row="0"
                                           Margin="4 0 0 0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Text="Username:" />
                                    <TextBlock x:Name="textBlockUsername"
                                               Grid.Column="3"
                                               Grid.Row="0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SelectedRecordPropertyMaskedConverter}">
                                                <Binding Path="SelectedRecord.Username" />
                                                <Binding ElementName="toggleButtonMaskUsername"
                                                         Path="IsChecked" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!--//  Row 2  //-->
                                    <Button Grid.Column="0"
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding CopyToClipboardCommand}"
                                            CommandParameter="{Binding SelectedRecord.Email}">
                                        <Button.Content>
                                            <Path Width="16"
                                                  Height="16"
                                                  Fill="{Binding Foreground,
                                                                 RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  Data="M 8,1 C 6.9013539,1 6,1.9013539 6,3 H 3.5 C 2.6776494,3 2,3.6776494 2,4.5 v 9 C 2,14.322351 2.6776494,15 3.5,15 h 9 c 0.822351,0 1.5,-0.677649 1.5,-1.5 v -9 C 14,3.6776494 13.322351,3 12.5,3 H 10 C 10,1.9013539 9.0986461,1 8,1 Z
                                                        M 8,2 C 8.5522847,2 9,2.4477153 9,3 9,3.5522847 8.5522847,4 8,4 7.4477153,4 7,3.5522847 7,3 7,2.4477153 7.4477153,2 8,2 Z
                                                        M 3.5,4 H 5 v 1 h 6 V 4 h 1.5 C 12.785648,4 13,4.2143517 13,4.5 v 9 c 0,0.285648 -0.214352,0.5 -0.5,0.5 h -9 C 3.2143517,14 3,13.785648 3,13.5 v -9 C 3,4.2143517 3.2143517,4 3.5,4 Z
                                                        M 5,7 v 1 h 6 V 7 Z
                                                        m 0,2 v 1 h 6 V 9 Z
                                                        m 0,2 v 1 h 4 v -1 z" />
                                        </Button.Content>
                                    </Button>
                                    <ToggleButton x:Name="toggleButtonMaskEmail"
                                                  Grid.Column="1"
                                                  Grid.Row="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Command="{Binding ToggleEmailMaskCommand}"
                                                  CommandParameter="{Binding IsChecked,
                                                                             RelativeSource={RelativeSource Mode=Self}}">
                                        <ToggleButton.Content>
                                            <MultiBinding Converter="{StaticResource BooleanToPathConverter}">
                                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="Foreground" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </ToggleButton.Content>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="2"
                                           Grid.Row="1"
                                           Margin="4 0 0 0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Text="Email:" />
                                    <TextBlock x:Name="textBlockEmail"
                                               Grid.Column="3"
                                               Grid.Row="1"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SelectedRecordPropertyMaskedConverter}">
                                                <Binding Path="SelectedRecord.Email" />
                                                <Binding ElementName="toggleButtonMaskEmail"
                                                         Path="IsChecked" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!--//  Row 3  //-->
                                    <Button Grid.Column="0"
                                            Grid.Row="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding CopyToClipboardCommand}"
                                            CommandParameter="{Binding SelectedRecord.Password}">
                                        <Button.Content>
                                            <Path Width="16"
                                                  Height="16"
                                                  Fill="{Binding Foreground,
                                                                 RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  Data="M 8,1 C 6.9013539,1 6,1.9013539 6,3 H 3.5 C 2.6776494,3 2,3.6776494 2,4.5 v 9 C 2,14.322351 2.6776494,15 3.5,15 h 9 c 0.822351,0 1.5,-0.677649 1.5,-1.5 v -9 C 14,3.6776494 13.322351,3 12.5,3 H 10 C 10,1.9013539 9.0986461,1 8,1 Z
                                                        M 8,2 C 8.5522847,2 9,2.4477153 9,3 9,3.5522847 8.5522847,4 8,4 7.4477153,4 7,3.5522847 7,3 7,2.4477153 7.4477153,2 8,2 Z
                                                        M 3.5,4 H 5 v 1 h 6 V 4 h 1.5 C 12.785648,4 13,4.2143517 13,4.5 v 9 c 0,0.285648 -0.214352,0.5 -0.5,0.5 h -9 C 3.2143517,14 3,13.785648 3,13.5 v -9 C 3,4.2143517 3.2143517,4 3.5,4 Z
                                                        M 5,7 v 1 h 6 V 7 Z
                                                        m 0,2 v 1 h 6 V 9 Z
                                                        m 0,2 v 1 h 4 v -1 z" />
                                        </Button.Content>
                                    </Button>
                                    <ToggleButton x:Name="toggleButtonMaskPassword" Grid.Column="1"
                                                  Grid.Row="2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Command="{Binding TogglePasswordMaskCommand}"
                                                  CommandParameter="{Binding IsChecked,
                                                                             RelativeSource={RelativeSource Mode=Self}}">
                                        <ToggleButton.Content>
                                            <MultiBinding Converter="{StaticResource BooleanToPathConverter}">
                                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="Foreground" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </ToggleButton.Content>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="2"
                                           Grid.Row="2"
                                           Margin="4 0 0 0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Text="Password:" />
                                    <TextBlock x:Name="textBlockPassword"
                                               Grid.Column="3"
                                               Grid.Row="2"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SelectedRecordPropertyMaskedConverter}">
                                                <Binding Path="SelectedRecord.Password" />
                                                <Binding ElementName="toggleButtonMaskPassword"
                                                         Path="IsChecked" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!--//  Row 4  //-->
                                    <Button Grid.Column="0"
                                            Grid.Row="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding CopyToClipboardCommand}"
