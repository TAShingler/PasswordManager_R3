                                                  Grid.Row="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Command="{Binding ToggleNotesMaskCommand}"
                                                  CommandParameter="{Binding IsChecked,
                                                                             RelativeSource={RelativeSource Mode=Self}}">
                                        <ToggleButton.Content>
                                            <MultiBinding Converter="{StaticResource BooleanToPathConverter}">
                                                <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="Foreground" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </ToggleButton.Content>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="2"
                                               Grid.Row="0"
                                               Margin="4 0 0 0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Text="Notes:"/>
                                    <ScrollViewer Grid.Column="3"
                                                  Grid.Row="0"
                                                  Grid.RowSpan="2"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Margin="0 9 0 0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SelectedRecordPropertyMaskedConverter}">
                                                    <Binding Path="SelectedRecord.Notes" />
                                                    <Binding ElementName="toggleButtonMaskNotes"
                                                             Path="IsChecked" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="Advanced"
                                 Margin="0 0 0 -1"
                                 BorderThickness="1 1 1 0">
                            <Border Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--//  Row 1  //-->
                                    <TextBlock Grid.Column="2"
                                           Grid.Row="0"
                                           Margin="4 0 0 0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Text="Expiration Date:" />
