                                          Visibility="Collapsed" />
                                </Grid>
                            </ToggleButton.Content>
                        </ToggleButton>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="New password"/>
                    <Grid Grid.Row="3"
                          Margin="0 6 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="tBoxNewPassword"
                                 Grid.Column="0"
                                 Panel.ZIndex="0"
                                 Visibility="Collapsed"
                                 TextChanged="tBoxNewPassword_TextChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ConfirmSetNewPasswordCommand}"
                                            CommandParameter="{Binding Text,
                                                                       RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <PasswordBox x:Name="pBoxNewPassword"
                                     Grid.Column="0"
                                     Panel.ZIndex="1"
                                     Visibility="Visible"
                                     PasswordChanged="pBoxNewPassword_PasswordChanged">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding ConfirmSetNewPasswordCommand}"
                                            CommandParameter="{Binding Text,
                                                                       ElementName=tBoxNewPassword}"/>
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                        <ToggleButton x:Name="tBtnNewPasswordVisibility"
                                      Grid.Column="1"
                                      Height="{Binding ElementName=pBoxNewPassword,
                                                       Path=ActualHeight}"
                                      Margin="12 0 0 0"
                                      IsChecked="False"
                                      Click="tBtnNewPasswordVisibility_Click">
