<UserControl x:Class="PasswordManager_R3.Views.LockScreen_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PasswordManager_R3.Views"
             xmlns:converters="clr-namespace:PasswordManager_R3.Converters"
             xmlns:vm="clr-namespace:PasswordManager_R3.ViewModels"
             xmlns:validate="clr-namespace:PasswordManager_R3.Validators"
             mc:Ignorable="d"
             SnapsToDevicePixels="True"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <!--//  CONVERTERS  //-->
        <converters:CheckedToVisibilityConverter x:Key="CheckedToVisibilityConverter" />
        <converters:ViewStateToVisibilityConverter x:Key="ViewStateToVisibilityConverter" />
        
        <!--//  COLORS  //-->
        <LinearGradientBrush x:Key="LogoBackground"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#6f50e2"
                              Offset="0" />
                <GradientStop Color="#3c1daf"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoDoorOuter"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#666666"
                              Offset="0" />
                <GradientStop Color="#333333"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoDoorInner"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#b2b2b2"
                              Offset="0" />
                <GradientStop Color="#808080"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoArmsOuter"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#ececec"
                              Offset="0" />
                <GradientStop Color="#cccccc"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoArmsInner"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#999999"
                              Offset="0" />
                <GradientStop Color="#666666"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoWheelOuter"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#808080"
                              Offset="0" />
                <GradientStop Color="#4d4d4d"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoWheelInner"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#cccccc"
                              Offset="0" />
                <GradientStop Color="#999999"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoRivets"
                             StartPoint="0.21,0"
                             EndPoint="0.79,1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#ececec"
                              Offset="0" />
                <GradientStop Color="#cccccc"
                              Offset="1" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical"
