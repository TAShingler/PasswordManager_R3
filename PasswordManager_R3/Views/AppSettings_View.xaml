<UserControl x:Class="PasswordManager_R3.Views.AppSettings_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PasswordManager_R3.Views"
             xmlns:convert="clr-namespace:PasswordManager_R3.Converters"
             xmlns:enum="clr-namespace:PasswordManager_R3.Enums"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <!--#region //  Converters  //-->
        <convert:BooleanToEnabledConverter x:Key="BooleanToEnabledConverter" />
        <convert:SelectedIndexToVisibilityConverter x:Key="SelectedIndexToVisibilityConverter" />
        <!--#endregion //  Converters  //-->
    </UserControl.Resources>

    <DockPanel>
        <!--//  Left Panel  //-->
        <ListView x:Name="listViewCategories"
                  DockPanel.Dock="Left"
                  Width="200"
                  Background="Transparent"
                  SelectedIndex="0">
            <ListViewItem>
                <ListViewItem.Content>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="24"
                              Height="24"
                              Margin="0 0 12 0"
                              Fill="{Binding Foreground,
                                             RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                              Data="M 12 3 A 9 9.000001 0 0 0 3 12 L 0 12 L 3.5 16 L 7 12 L 4 12 A 8 8.000001 0 0 1 12 4 A 8 8.000001 0 0 1 20 12 A 8 8.000001 0 0 1 12 20 A 8 8.000001 0 0 1 7.4316406 18.568359 L 6.7148438 19.285156 A 9 9.000001 0 0 0 12 21 A 9 9.000001 0 0 0 21 12 A 9 9.000001 0 0 0 12 3 z
                                    M 12 10 A 2 2.0000002 0 0 0 10 12 A 2 2.0000002 0 0 0 12 14 A 2 2.0000002 0 0 0 14 12 A 2 2.0000002 0 0 0 12 10 z" />
                        <TextBlock Text="Backup"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem.Content>
            </ListViewItem>
            <ListViewItem>
                <ListViewItem.Content>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="24"
                              Height="24"
                              Margin="0 0 12 0"
                              Fill="{Binding Foreground,
                                             RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                              Data="M 12 3 A 8 4.0000005 0 0 0 4 7 L 4 17 A 8 4.0000005 0 0 0 12 21 A 8 4.0000005 0 0 0 20 17 L 20 7 A 8 4.0000005 0 0 0 12 3 z
                                    M 12 4 A 7 3.0000002 0 0 1 19 7 A 7 3.0000002 0 0 1 12 10 A 7 3.0000002 0 0 1 5 7 A 7 3.0000002 0 0 1 12 4 z
                                    M 5 8.9355469 A 8 4.0000005 0 0 0 12 11 A 8 4.0000005 0 0 0 19 8.9355469 L 19 12 A 7 3.0000002 0 0 1 12 15 A 7 3.0000002 0 0 1 5 12 L 5 8.9355469 z
                                    M 5 13.935547 A 8 4.0000005 0 0 0 12 16 A 8 4.0000005 0 0 0 19 13.935547 L 19 17 A 7 3 0 0 1 12 20 A 7 3 0 0 1 5 17 L 5 13.935547 z" />
                        <TextBlock Text="Database"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem.Content>
            </ListViewItem>
            <ListViewItem>
                <ListViewItem.Content>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="24"
                              Height="24"
                              Margin="0 0 12 0"
                              Fill="{Binding Foreground,
                                             RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                              Data="M 3,2 C 1.892,2 1,2.892 1,4 v 12 c 0,1.108 0.892,2 2,2 h 7 v 3 H 8.5 C 8.223,21 8,21.223 8,21.5 8,21.777 8.223,22 8.5,22 h 7 C 15.777,22 16,21.777 16,21.5 16,21.223 15.777,21 15.5,21 H 14 v -3 h 7 c 1.108,0 2,-0.892 2,-2 V 4 C 23,2.892 22.108,2 21,2 Z
                                    m 0,1 h 18 c 0.554,0 1,0.4459999 1,1 v 12 c 0,0.554 -0.446,1 -1,1 H 3 C 2.4459999,17 2,16.554 2,16 V 4 C 2,3.4459999 2.4459999,3 3,3 Z
                                    M 6,6 C 5.4459999,6 5,6.4459999 5,7 v 3 c 0,0.554 0.4459999,1 1,1 h 7 c 0.554,0 1,-0.446 1,-1 V 7 C 14,6.4459999 13.554,6 13,6 Z
                                    m 10,0 c -0.554,0 -1,0.4459999 -1,1 0,0.5540001 0.446,1 1,1 h 2 C 18.554,8 19,7.5540001 19,7 19,6.4459999 18.554,6 18,6 Z
                                    M 6,7 h 7 v 3 H 6 Z
                                    m 10,2 c -0.554,0 -1,0.4459999 -1,1 v 3 c 0,0.554 0.446,1 1,1 h 2 c 0.554,0 1,-0.446 1,-1 V 10 C 19,9.4459999 18.554,9 18,9 Z
                                    m 0,1 h 2 v 3 H 16 Z
                                    M 6,12 c -0.5540001,0 -1,0.446 -1,1 0,0.554 0.4459999,1 1,1 H 8 C 8.5540001,14 9,13.554 9,13 9,12.446 8.5540001,12 8,12 Z
                                    m 5,0 c -0.554,0 -1,0.446 -1,1 0,0.554 0.446,1 1,1 h 2 c 0.554,0 1,-0.446 1,-1 0,-0.554 -0.446,-1 -1,-1 z
                                    m 0,6 h 2 v 3 h -2 z" />
                        <TextBlock Text="Display"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem.Content>
            </ListViewItem>
        </ListView>

        <!--//  Bottom Panel  //-->
        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Margin="6 0"
                    Width="75"
                    Content="Save"
                    Command="{Binding ConfirmButtonCommand}" />
            <Button Grid.Column="2"
                    Margin="6 0 0 0"
                    Width="75"
                    Content="Cancel"
                    Command="{Binding CancelButtonCommand}" />
        </Grid>
        
        <!--//  Center Panel  //-->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="12 0 0 12">
            <Grid>
                <ScrollViewer Padding="12"
                              Visibility="{Binding SelectedIndex,
                                                   ElementName=listViewCategories,
                                                   Converter={StaticResource SelectedIndexToVisibilityConverter},
                                                   ConverterParameter=0}">
                    <Grid Margin="12 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--//  Row 1  //-->
                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Auto backup count" />
                        <StackPanel Grid.Column="1"
                                    Grid.Row="0"
                                    Margin="0 0 0 12"
                                    Orientation="Horizontal">
                            <TextBox x:Name="txtBoxAutoBackupCount"
                                     Width="100"
                                     Margin="0 0 4 0"
                                     Text="{Binding AutoBackupCount}"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Right"/>
                            <StackPanel Orientation="Vertical">
                                <RepeatButton Padding="11 4"
                                              Margin="0 0 0 2"
                                              Command="{Binding IncrementAutoBackupCountCommand}">
                                    <RepeatButton.Content>
                                        <Path Width="8"
                                              Height="4"
                                              Fill="{Binding Foreground,
                                                             RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                              Data="M 0 4 4 0 8 4 Z" />
                                    </RepeatButton.Content>
                                </RepeatButton>
                                <RepeatButton Padding="11 4"
                                              Margin="0 2 0 0"
                                              Command="{Binding DecrementAutoBackupCountCommand}">
                                    <RepeatButton.Content>
                                        <Path Width="8"
                                              Height="4"
                                              Fill="{Binding Foreground,
                                                             RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                              Data="M 0 0 4 4 8 0 Z" />
                                    </RepeatButton.Content>
                                </RepeatButton>
                            </StackPanel>
                        </StackPanel>

                        <!--//  Row 2  //-->
                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Text="Backup location"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Grid.Row="1"
                                 Text="{Binding BackupLocation}" />
                        <Button Grid.Column="2"
                                Grid.Row="1"
                                Margin="12 0 0 0"
                                Content="Browse..."
                                Command="{Binding BackupLocationButtonCommand}" />
                    </Grid>
                </ScrollViewer>
                <ScrollViewer Padding="12"
                              Visibility="{Binding SelectedIndex,
                                                   ElementName=listViewCategories,
                                                   Converter={StaticResource SelectedIndexToVisibilityConverter},
                                                   ConverterParameter=1}">
                    <Grid Margin="12 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!--//  Row 1  //-->
                        <CheckBox x:Name="checkBoxEnableEraseAttempts"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3"
                                  Margin="0 0 0 12"
                                  IsChecked="{Binding EraseDatabaseAfterSetAmountAttempts}"
                                  Content="Erase database after set amount of attempts" />
                        
                        <!--//  Row 2  //-->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Padding="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Attempts before erasing" />
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0 0 0 12"
                                    Orientation="Horizontal">
                            <TextBox x:Name="txtBoxUnlockAttempts"
                                     Width="100"
                                     Margin="0 0 4 0"
                                     IsEnabled="{Binding IsChecked,
                                                         ElementName=checkBoxEnableEraseAttempts}"
                                     Text="{Binding UnlockAttempts}"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     PreviewKeyDown="NumericUpDownTextBox_PreviewKeyDown"/>
                            <StackPanel Orientation="Vertical">
                                <RepeatButton Padding="11 4"
                                              Margin="0 0 0 2"
                                              IsEnabled="{Binding IsChecked,
                                                                  ElementName=checkBoxEnableEraseAttempts}"
                                              Command="{Binding IncrementUnlockAttemptsCommand}">
                                    <RepeatButton.Content>
                                        <Path Width="8"
                                              Height="4"
                                              Fill="{Binding Foreground,
                                                             RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                              Data="M 0 4 H 8 L 4 0 Z" />
                                    </RepeatButton.Content>
                                </RepeatButton>
                                <RepeatButton Padding="11 4"
                                              Margin="0 2 0 0"
                                              IsEnabled="{Binding IsChecked,
                                                                  ElementName=checkBoxEnableEraseAttempts}"
                                              Command="{Binding DecrementUnlockAttemptsCommand}">
                                    <RepeatButton.Content>
                                        <Path Width="8"
                                              Height="4"
                                              Fill="{Binding Foreground,
                                                             RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                              Data="M 0 0 H 8 L 4 4 Z" />
                                    </RepeatButton.Content>
                                </RepeatButton>
                            </StackPanel>
                        </StackPanel>

                        <!--//  Row 3  //-->
                        <Separator Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0 0 0 6"/>

                        <!--//  Row 4  //-->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Padding="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Security timeout (in minutes)" />
                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0 0 0 12"
                                    Orientation="Horizontal">
                            <TextBox x:Name="txtBoxTimeoutMinutes"
                                     Width="100"
                                     Margin="0 0 4 0"
                                     Text="{Binding TimeoutMinutes}"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     PreviewKeyDown="NumericUpDownTextBox_PreviewKeyDown"/>
                            <StackPanel Orientation="Vertical">
                                <RepeatButton Padding="11 4"
                                              Margin="0 0 0 2"
                                              Command="{Binding IncrementTimeoutMinutesCommand}">
                                    <RepeatButton.Content>
                                        <Path Width="8"
                                              Height="4"
                                              Fill="{Binding Foreground,
                                                             RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                              Data="M 0 4 H 8 L 4 0 Z" />
                                    </RepeatButton.Content>
                                </RepeatButton>
                                <RepeatButton Padding="11 4"
                                              Margin="0 2 0 0"
                                              Command="{Binding DecrementTimeoutMinutesCommand}">
                                    <RepeatButton.Content>
                                        <Path Width="8"
                                              Height="4"
                                              Fill="{Binding Foreground,
                                                             RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                                              Data="M 0 0 H 8 L 4 4 Z" />
                                    </RepeatButton.Content>
                                </RepeatButton>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <ScrollViewer Padding="12"
                              Visibility="{Binding SelectedIndex,
                                                   ElementName=listViewCategories,
                                                   Converter={StaticResource SelectedIndexToVisibilityConverter},
                                                   ConverterParameter=2}">
                    <Grid Margin="12 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!--//  Row 1  //-->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0 6 0 12"
                                   Text="Expand/Collapse buttons"/>
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    Margin="0 0 0 12">
                            <RadioButton IsChecked="{Binding PlusMinusSignsRadioButtonIsChecked}"
                                         Content="Plus/Minus signs"
                                         Command="{Binding ExpandCollapseButtonsCommand}"
                                         CommandParameter="{x:Static enum:TreeExpandCollapseButtonStyle.PlusMinusSigns}" />
                            <RadioButton IsChecked="{Binding ArrowsRadioButtonIsChecked}"
                                         Content="Arrows"
                                         Command="{Binding ExpandCollapseButtonsCommand}"
                                         CommandParameter="{x:Static enum:TreeExpandCollapseButtonStyle.Arrows}" />
                            <RadioButton IsChecked="{Binding FoldersRadioButtonIsChecked}"
                                         Content="Folders"
                                         Command="{Binding ExpandCollapseButtonsCommand}"
                                         CommandParameter="{x:Static enum:TreeExpandCollapseButtonStyle.Folders}" />
                        </StackPanel>

                        <!--//  Row 2  //-->
                        <Separator Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0 0 0 6"/>

                        <!--//  Row 3  //-->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Mask usernames" />
                        <CheckBox Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0 0 0 12"
                                  IsChecked="{Binding AreDatabaseUsernamesMasked}" />

                        <!--//  Row 4  //-->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Padding="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Mask email addresses" />
                        <CheckBox Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0 0 0 12"
                                  IsChecked="{Binding AreDatabaseEmailsMasked}" />

                        <!--//  Row 5  //-->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Mask passwords" />
                        <CheckBox Grid.Row="4"
                                  Grid.Column="1"
                                  Margin="0 0 0 12"
                                  IsChecked="{Binding AreDatabasePasswordsMasked}" />

                        <!--//  Row 6  //-->
                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Mask website URLs" />
                        <CheckBox Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0 0 0 12"
                                  IsChecked="{Binding AreDatabaseUrlsMasked}" />

                        <!--//  Row 7  //-->
                        <Separator Grid.Row="6"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0 0 0 6" />

                        <!--//  Row 8  //-->
                        <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   Margin="0 6 0 12"
                                   VerticalAlignment="Top"
                                   Text="Quick access icon size" />
                        <StackPanel Grid.Row="7"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    Margin="0 0 0 12">
                            <RadioButton IsChecked="{Binding QuickAccessSmallRadioButtonIsChecked}"
                                         Content="Small"
                                         Command="{Binding QuickAccessIconSizeCommand}"
                                         CommandParameter="{x:Static enum:QuickAccessIconSize.Small}" />
                            <RadioButton IsChecked="{Binding QuickAccessMediumRadioButtonIsChecked}"
                                         Content="Medium"
                                         Command="{Binding QuickAccessIconSizeCommand}"
                                         CommandParameter="{x:Static enum:QuickAccessIconSize.Medium}" />
                            <RadioButton IsChecked="{Binding QuickAccessLargeRadioButtonIsChecked}"
                                         Content="Large"
                                         Command="{Binding QuickAccessIconSizeCommand}"
                                         CommandParameter="{x:Static enum:QuickAccessIconSize.Large}" />
                        </StackPanel>

                        <!--//  Row 9  //-->
                        <Separator Grid.Row="8"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0 0 0 6" />

                        <!--//  Row 10  //-->
                        <TextBlock Grid.Row="9"
                                   Grid.Column="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Display Groups Panel"/>
                        <CheckBox Grid.Row="9"
                                  Grid.Column="1"
                                  Margin="0 0 0 12"
                                  IsChecked="{Binding DisplayGroupsTree}"/>

                        <!--//  Row 11  //-->
                        <TextBlock Grid.Row="10"
                                   Grid.Column="0"
                                   Margin="0 0 0 12"
                                   VerticalAlignment="Center"
                                   Text="Display Item Details Panel"/>
                        <CheckBox Grid.Row="10"
                                   Grid.Column="1"
                                   Margin="0 0 0 12"
                                   IsChecked="{Binding DisplayInfoPane}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
