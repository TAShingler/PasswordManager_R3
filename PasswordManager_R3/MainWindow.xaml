<Window x:Class="PasswordManager_R3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager_R3"
        xmlns:converters="clr-namespace:PasswordManager_R3.Converters"
        xmlns:vm="clr-namespace:PasswordManager_R3.ViewModels"
        xmlns:views="clr-namespace:PasswordManager_R3.Views"
        xmlns:enums="clr-namespace:PasswordManager_R3.Enums"
        mc:Ignorable="d"
        Title="Password LockBox"
        MinHeight="650"
        Height="800"
        MinWidth="900"
        Width="1200"
        FontSize="14"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowState="{Binding WinState}"
        x:Name="WinMain"
        Loaded="WinMain_Loaded">

    <!--Background="{StaticResource solidColorBrush-static-background}"-->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Activated">
            <i:InvokeCommandAction Command="{Binding WindowActivatedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Deactivated">
            <i:InvokeCommandAction Command="{Binding WindowDeactivatedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewMouseDown">
            <i:InvokeCommandAction Command="{Binding WindowPreviewMouseDownCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="PreviewKeyDown">
            <i:InvokeCommandAction Command="{Binding WindowPreviewKeyDownCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <!--PreviewMouseDown="WinMain_PreviewMouseDown"
        Activated="WinMain_Activated"
        Deactivated="WinMain_Deactivated">-->

    <Window.DataContext>
        <vm:MainWindow_ViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!--#region //  DATA TEMPLATES FOR VIEWS  // -->
        <DataTemplate DataType="{x:Type vm:LockScreen_ViewModel}">
            <views:LockScreen_View />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Database_ViewModel}">
            <views:Database_View />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddEditRecord_ViewModel}">
            <views:AddEditRecord_View />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddEditGroup_ViewModel}">
            <views:AddEditGroup_View />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppSettings_ViewModel}">
            <views:AppSettings_View />
        </DataTemplate>
        <!--#endregion //  DATA TEMPLATES FOR VIEWS  // -->

        <!--#region //  CONVERTERS  //-->
        <converters:ViewStateToVisibilityConverter x:Key="ViewStateToVisibilityConverter" />
        <converters:ViewStateToBorderThicknessConverter x:Key="ViewStateToBorderThicknessConverter" />
        <converters:BooleanToEnabledConverter x:Key="BooleanToEnabledConverter" />
        <converters:QuickAccessIconSizeToDoubleConverter x:Key="QuickAccessIconSizeToDoubleConverter" />
        <!--#endregion //  CONVERTERS  //-->
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Menu>
                <MenuItem Header="Database"
                          IsEnabled="{Binding MenuItemDatabaseIsEnabled}">
                    <MenuItem Header="Set Password..."
                              IsEnabled="{Binding MenuItemSetPasswordIsEnabled}"
                              Command="{Binding LockDatabaseCommand}"
                              CommandParameter="{x:Static enums:LockScreenState.SetNewPassword}"/>
                    <Separator />
                    <MenuItem Header="Backup..."
                              IsEnabled="{Binding MenuItemManualDatabaseBackupIsEnabled}"
                              Command="{Binding ManualDatabaseBackupCommand}"/>
                    <MenuItem Header="Restore..."
                              IsEnabled="{Binding MenuItemRestoreDatabaseIsEnabled}"
                              Command="{Binding RestoreDatabaseCommand}"/>
                    <Separator />
                    <MenuItem Header="Lock Database"
                              IsEnabled="{Binding ButtonLockDatabaseIsEnabled}"
                              Command="{Binding LockDatabaseCommand}"
                              CommandParameter="{x:Static enums:LockScreenState.LockDatabase}" />
                    <Separator />
                    <MenuItem Header="Exit"
                              IsEnabled="True"
                              Command="{Binding CloseWindowCommand}"
                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                </MenuItem>
                <MenuItem Header="Groups"
                          IsEnabled="{Binding MenuItemGroupsIsEnabled}">
                    <MenuItem Header="Add Group"
                              IsEnabled="{Binding CanCreateNewGroup}"
                              Command="{Binding CreateNewGroupCommand}"/>
                    <MenuItem Header="Edit Group"
                              IsEnabled="{Binding CanEditSelectedGroup}"
                              Command="{Binding EditSelectedGroupCommand}"/>
                    <MenuItem Header="Delete Group"
                              IsEnabled="{Binding CanDeleteSelectedGroup}"
                              Command="{Binding DeleteSelectedGroupCommand}"/>
                    <MenuItem Header="Duplicate/Clone Group" />
                </MenuItem>
                <MenuItem Header="Entries"
                          IsEnabled="{Binding MenuItemEntriesIsEnabled}">
                    <MenuItem Header="Add Entry"
                              IsEnabled="{Binding ButtonAddRecordIsEnabled}"
                              Command="{Binding AddRecordCommand}"/>
                    <MenuItem Header="Edit Entry"
                              IsEnabled="{Binding ButtonEditRecordIsEnabled}"
                              Command="{Binding EditRecordCommand}"/>
                    <MenuItem Header="Delete Entry"
                              IsEnabled="{Binding ButtonDeleteRecordIsEnabled}"
                              Command="{Binding DeleteRecordCommand}"/>
                    <MenuItem Header="Duplicate/Clone Entry" />
                    <Separator />
                    <MenuItem Header="Copy Username"
                              IsEnabled="{Binding ButtonUsernameToClipboardIsEnabled}"
                              Command="{Binding CopyUsernameToClipboardCommand}" />
                    <MenuItem Header="Copy Email"
                              IsEnabled="{Binding ButtonEmailToClipboardIsEnabled}"
                              Command="{Binding CopyEmailToClipboardCommand}"/>
                    <MenuItem Header="Copy Password"
                              IsEnabled="{Binding ButtonPasswordToClipboardIsEnabled}"
                              Command="{Binding CopyPasswordToClipboardCommand}"/>
                    <MenuItem Header="Copy URL"
                              IsEnabled="{Binding ButtonUrlToClipboardIsEnabled}"
                              Command="{Binding CopyUrlToClipboardCommand}"/>
                </MenuItem>
                <MenuItem Header="Tools"
                          IsEnabled="{Binding MenuItemToolsIsEnabled}">
                    <MenuItem Header="Settings"
                              IsEnabled="{Binding ButtonAppSettingsIsEnabled}"
                              Command="{Binding AppSettingsCommand}"/>
                </MenuItem>
                <MenuItem Header="View"
                          IsEnabled="{Binding MenuItemViewIsEnabled}">
                    <MenuItem Header="Theme"
                              IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="Mask Usernames"
                              IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}},
                                                  Path=IsEnabled}"
                              IsCheckable="True"
                              IsChecked="{Binding AreDatabaseUsernamesMasked,
                                                  Mode=TwoWay}" />
                    <MenuItem Header="Mask Emails"
                              IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}},
                                                  Path=IsEnabled}"
                              IsCheckable="True"
                              IsChecked="{Binding AreDatabaseEmailsMasked,
                                                  Mode=TwoWay}" />
                    <MenuItem Header="Mask Passwords"
                              IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}},
                                                  Path=IsEnabled}"
                              IsCheckable="True"
                              IsChecked="{Binding AreDatabasePasswordsMasked,
                                                  Mode=TwoWay}" />
                    <MenuItem Header="Mask Urls"
                              IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}},
                                                  Path=IsEnabled}"
                              IsCheckable="True"
                              IsChecked="{Binding AreDatabaseUrlsMasked,
                                                  Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="Show Groups Tree"
                              IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}},
                                                  Path=IsEnabled}"
                              IsCheckable="True"
                              IsChecked="{Binding IsGroupsTreePaneEnabled}"
                              Command="{Binding ToggleTreeViewVisibilityCommand}"/>
                    <MenuItem Header="Show Details Panel"
                              IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}},
                                                  Path=IsEnabled}"
                              IsCheckable="True"
                              IsChecked="{Binding IsRecordDetailsPaneEnabled}"
                              Command="{Binding ToggleRecordDetailsPanelVisibilityCommand}"/>
                    <MenuItem Header="Show Quick Access Tolbar"
                              IsEnabled="False" />
                    <Separator Visibility="Collapsed" />
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="About"
                              IsEnabled="True"
                              Command="{Binding DisplayAboutWindowCommand}"/>
                </MenuItem>
            </Menu>
