<Window x:Class="PasswordManager_R3.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager_R3"
        mc:Ignorable="d"
        Title="About"
        Height="300"
        Width="400">

    <Border Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Height="24"
                        Orientation="Horizontal">
                <Image Source="C:\Users\tyler\Desktop\path1044_x96.png" />
                <TextBlock Text="About" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Vertical">
                <TextBlock Text="AppName" />
                <TextBlock Text="Version" />
                <TextBlock Text="Copyright1" />
                <TextBlock Text="Copyright2" />
                <TextBlock Text="Copyright3" />

                <Label Content="Product Details" />
                <ScrollViewer />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal">
                <Border Padding="24"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border Padding="24"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Border Padding="24"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">

                        </Border>
                    </Border>
                </Border>
                <Border Padding="24"
                        Margin="0 24 0 0"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border Padding="24"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Border Padding="24"
                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">

                        </Border>
                    </Border>
                </Border>
                <Border Padding="24"
                        Margin="0 24 0 0"
                        Background="{DynamicResource SmokeFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border Padding="24"
                            Background="{DynamicResource SmokeFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Border Padding="24"
                                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">

                        </Border>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
